# GoalGear Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file with real credentials to GitHub.

# Application Server Port (defaults to 3000 if not specified)
PORT=3000

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-secret-key

# JWT Secret for signing customer and admin session tokens
# Use a long, random string in production (e.g., generated with `openssl rand -hex 32`)
JWT_SECRET=super_secret_goalgear_jwt_token_key_change_me_in_production
JWT_EXPIRES_IN=7d
